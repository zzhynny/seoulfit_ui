# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend (copied in alongside the app it serves).
# The venv is machine-specific and 600MB; .env holds live API keys and must
# never be committed. checkins.db is local research data.
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.env
backend/checkins.db

# Live Google Places key. The file says so itself, but it was tracked anyway
# and the key rode 21 unpushed commits before this line existed.
lib/config/api_keys.dart
backend/.pytest_cache/
